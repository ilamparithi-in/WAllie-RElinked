[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "requestHeaders": [
        {
          "header": "User-Agent",
          "operation": "set",
          "value": "Mozilla/5.0 (compatible; Discordbot/2.0; +https://discordapp.com)"
        },
        {
          "header": "sec-ch-ua",
          "operation": "remove"
        },
        {
          "header": "sec-ch-ua-mobile",
          "operation": "remove"
        },
        {
          "header": "sec-ch-ua-platform",
          "operation": "remove"
        }
      ]
    },
    "condition": {
      "urlFilter": "*",
      "resourceTypes": ["xmlhttprequest", "other"],
      "initiatorDomains": [
        "web.whatsapp.com",
        "whatsapp.com"
      ],
      "excludedRequestDomains": [
        "whatsapp.com",
        "whatsapp.net",
        "facebook.com",
        "fbcdn.net",
        "meta.com"
      ]
    }
  }
]
